# These are the settings the server reads. You do NOT upload this file.
# Type them into your hosting dashboard (Render > Environment) instead.

OPENAI_API_KEY=paste-your-key-here

# Optional - only change if you know why:
# OPENAI_MODEL_DEFAULT=gpt-6.1-terra
# OPENAI_MODEL_QUICK=gpt-6-luna
# OPENAI_STT_MODEL=gpt-transcribe
# OPENAI_TTS_MODEL=            (empty = free browser voice)
# DAILY_REQUEST_LIMIT=1500
